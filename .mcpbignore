# Files to exclude from the MCPB bundle (`mcpb pack`). Gitignore-style syntax.
# A leading "/" anchors to the bundle root so these do NOT match same-named
# paths inside node_modules (e.g. a bare "src/" would delete node_modules/debug/src).

# --- Repo sources & tooling — the runtime only needs dist/ ---
/src/
/.github/
/.husky/
/.vscode/
/.kiro/
/scripts/
/services/
/tests/
/coverage/
/docs/
/tsconfig*.json
/vitest.config.ts
/vitest.state.ts
/eslint.config.js
/commitlint.config.js
/.markdownlint.json
/.codacy.yml
/.gitignore
/.mcpbignore
/.npmignore
/.public-export.json
/.editorconfig
/.gitattributes
/Dockerfile
/CHANGELOG.md
/INSTALL-PRIVATE.md
/SECURITY.md
/blueprint.md
/eslint.config.mjs
/vitest.config.public.ts
/vitest.live.config.ts

# --- Dependency non-runtime files only (docs + type declarations + source maps) ---
# (mcpb pack already drops *.map and lockfiles by default; listed here for clarity.)
node_modules/**/*.md
node_modules/**/*.markdown
node_modules/**/*.d.ts
node_modules/**/*.d.cts
node_modules/**/*.d.mts
node_modules/**/*.map
node_modules/.package-lock.json
node_modules/**/docs/
node_modules/**/.github/
node_modules/**/example/
node_modules/**/examples/
node_modules/**/test/
node_modules/**/tests/
node_modules/**/__tests__/
node_modules/**/fixture/
node_modules/**/fixtures/
node_modules/**/benchmark/
node_modules/**/benchmarks/
node_modules/**/*.test.js
node_modules/**/*.test.cjs
node_modules/**/*.test.mjs
node_modules/**/*.test.ts
node_modules/**/*.spec.js
node_modules/**/*.spec.cjs
node_modules/**/*.spec.mjs
node_modules/**/*.spec.ts

# --- Lockfiles (npm; also excluded by mcpb pack defaults) ---
/package-lock.json

# --- Pack-time sources (copied over the shipped files at pack time); drop them ---
/manifest.private.json
/icon.svg
/icon-private.svg
/icon-private.png
