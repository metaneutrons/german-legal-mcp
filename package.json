{
  "name": "@metaneutrons/german-legal-mcp",
  "version": "4.2.0",
  "packageManager": "pnpm@12.3.4",
  "description": "MCP server and typed components for German, Austrian and EU legal research",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./components/case-law": {
      "types": "./dist/components/case-law/index.d.ts",
      "import": "./dist/components/case-law/index.js"
    },
    "./components/legislation": {
      "types": "./dist/components/legislation/index.d.ts",
      "import": "./dist/components/legislation/index.js"
    },
    "./components/arxiv": {
      "types": "./dist/providers/arxiv/index.d.ts",
      "import": "./dist/providers/arxiv/index.js"
    },
    "./components/dip": {
      "types": "./dist/providers/dip/index.d.ts",
      "import": "./dist/providers/dip/index.js"
    },
    "./components/eul": {
      "types": "./dist/providers/eul/index.d.ts",
      "import": "./dist/providers/eul/index.js"
    },
    "./components/icu": {
      "types": "./dist/providers/icu/index.d.ts",
      "import": "./dist/providers/icu/index.js"
    },
    "./components/legis": {
      "types": "./dist/providers/legis/index.d.ts",
      "import": "./dist/providers/legis/index.js"
    },
    "./components/rii": {
      "types": "./dist/providers/rii/index.d.ts",
      "import": "./dist/providers/rii/index.js"
    },
    "./components/ris": {
      "types": "./dist/providers/ris/index.d.ts",
      "import": "./dist/providers/ris/index.js"
    },
    "./components/nautos": {
      "types": "./dist/providers/nautos/index.d.ts",
      "import": "./dist/providers/nautos/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "german-legal-mcp": "dist/bin/german-legal-mcp.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaneutrons/german-legal-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/metaneutrons/german-legal-mcp/issues"
  },
  "homepage": "https://github.com/metaneutrons/german-legal-mcp#readme",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/write-build-id.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:live": "tsc -p tsconfig.live.json --noEmit",
    "start": "node dist/bin/german-legal-mcp.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "debug": "node --inspect dist/bin/german-legal-mcp.js",
    "prepublishOnly": "pnpm run verify",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests scripts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "test:tool-names": "node scripts/verify-tool-names.mjs",
    "test:runtime-tools": "node scripts/verify-runtime-tools.mjs",
    "test:version-ssot": "node scripts/verify-version-ssot.mjs",
    "sync:manifest-tools": "pnpm run build && node scripts/verify-runtime-tools.mjs --write",
    "test:smoke": "node scripts/smoke-startup.mjs",
    "test:live": "pnpm run test:live:public",
    "test:live:public": "GLMCP_LIVE_PUBLIC=1 vitest run --config vitest.live.config.ts tests/live/public-providers.live.ts tests/live/german-adapters.live.ts",
    "test:live:all": "pnpm run test:live:public",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:live && pnpm run build && pnpm run test:version-ssot && pnpm run test:tool-names && pnpm run test:runtime-tools && pnpm run test:coverage && pnpm run test:package && pnpm run test:smoke && pnpm audit --prod --audit-level=high"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "mcp",
    "legal",
    "german",
    "law"
  ],
  "author": {
    "name": "Fabian Schmieder"
  },
  "license": "GPL-3.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "turndown": "^7.2.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/turndown": "^5.0.6",
    "lefthook": "^2.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.13.0",
    "fast-check": "4.10.2",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
