{
  "name": "@metaneutrons/german-legal-mcp",
  "version": "1.2.2",
  "description": "MCP server for German legal research",
  "main": "dist/index.js",
  "bin": {
    "german-legal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaneutrons/german-legal-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/metaneutrons/german-legal-mcp/issues"
  },
  "homepage": "https://github.com/metaneutrons/german-legal-mcp#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "debug": "node --inspect dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=25.0.0"
  },
  "keywords": [
    "mcp",
    "legal",
    "german",
    "law"
  ],
  "author": {
    "name": "Fabian Schmieder"
  },
  "license": "GPL-3.0",
  "type": "module",
  "lint-staged": {
    "package.json": [
      "npm audit --audit-level=high"
    ],
    "*.ts": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/node": "^25.5.0",
    "@types/tough-cookie": "^4.0.5",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.13.6",
    "axios-cookiejar-support": "^6.0.5",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "ioredis": "^5.10.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tough-cookie": "^6.0.1",
    "ts-node": "^10.9.2",
    "turndown": "^7.2.2",
    "typescript": "^6.0.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/ioredis": "^5.0.0",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "standard-version": "^9.5.0",
    "vitest": "^4.1.0"
  }
}
